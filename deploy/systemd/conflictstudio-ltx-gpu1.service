[Unit]
Description=ConflictStudio LTX 2.3 model service on GPU1
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/team/lvshuyang/ComfyUI
Environment=CUDA_VISIBLE_DEVICES=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_CACHE_HOME=/home/team/zhanghaonan/ConflictStudio-data/gpu1/cache
ReadOnlyPaths=/home/team/lvshuyang/ComfyUI
ExecStartPre=/usr/bin/mkdir -p /home/team/zhanghaonan/ConflictStudio-data/gpu1/input /home/team/zhanghaonan/ConflictStudio-data/gpu1/output /home/team/zhanghaonan/ConflictStudio-data/gpu1/temp /home/team/zhanghaonan/ConflictStudio-data/gpu1/user /home/team/zhanghaonan/ConflictStudio-data/gpu1/cache /home/team/zhanghaonan/ConflictStudio-data/logs
ExecStart=/home/team/lvshuyang/anaconda3/envs/comfyui/bin/python /home/team/lvshuyang/ComfyUI/main.py --listen 127.0.0.1 --port 8189 --disable-auto-launch --input-directory /home/team/zhanghaonan/ConflictStudio-data/gpu1/input --output-directory /home/team/zhanghaonan/ConflictStudio-data/gpu1/output --temp-directory /home/team/zhanghaonan/ConflictStudio-data/gpu1/temp --user-directory /home/team/zhanghaonan/ConflictStudio-data/gpu1/user
StandardOutput=append:/home/team/zhanghaonan/ConflictStudio-data/logs/conflictstudio-ltx-gpu1.log
StandardError=append:/home/team/zhanghaonan/ConflictStudio-data/logs/conflictstudio-ltx-gpu1.log
Restart=no

[Install]
WantedBy=default.target
