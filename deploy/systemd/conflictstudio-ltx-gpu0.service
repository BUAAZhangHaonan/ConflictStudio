[Unit]
Description=ConflictStudio LTX 2.3 model service on GPU0
After=network.target
Conflicts=conflictstudio-h3-gpu0.service conflictstudio-ltx25-bf16-gpu0.service conflictstudio-ltx25-int8-gpu0.service

[Service]
Type=simple
WorkingDirectory=/home/team/lvshuyang/ComfyUI
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_CACHE_HOME=/home/team/zhanghaonan/ConflictStudio-data/gpu0/cache
ReadOnlyPaths=/home/team/lvshuyang/ComfyUI
ExecStartPre=/usr/bin/mkdir -p /home/team/zhanghaonan/ConflictStudio-data/gpu0/input /home/team/zhanghaonan/ConflictStudio-data/gpu0/output /home/team/zhanghaonan/ConflictStudio-data/gpu0/temp /home/team/zhanghaonan/ConflictStudio-data/gpu0/user /home/team/zhanghaonan/ConflictStudio-data/gpu0/cache /home/team/zhanghaonan/ConflictStudio-data/logs
ExecStart=/home/team/lvshuyang/anaconda3/envs/comfyui/bin/python /home/team/lvshuyang/ComfyUI/main.py --listen 127.0.0.1 --port 8188 --disable-auto-launch --input-directory /home/team/zhanghaonan/ConflictStudio-data/gpu0/input --output-directory /home/team/zhanghaonan/ConflictStudio-data/gpu0/output --temp-directory /home/team/zhanghaonan/ConflictStudio-data/gpu0/temp --user-directory /home/team/zhanghaonan/ConflictStudio-data/gpu0/user
StandardOutput=append:/home/team/zhanghaonan/ConflictStudio-data/logs/conflictstudio-ltx-gpu0.log
StandardError=append:/home/team/zhanghaonan/ConflictStudio-data/logs/conflictstudio-ltx-gpu0.log
Restart=no

