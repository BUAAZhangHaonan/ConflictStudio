{
  "name": "conflictstudio",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "typecheck": "npm --prefix frontend run typecheck",
    "build": "npm --prefix frontend run build",
    "copy:check": "node scripts/copy-check.mjs",
    "built:check": "node scripts/randomuuid-gate.mjs",
    "test:time": "node --test scripts/time.test.mts",
    "test:review-archive": "node --test scripts/review-archive.test.mts",
    "test:copy": "node --test scripts/copy-check.test.mjs",
    "test:api": "node --test scripts/api-wiring.test.mjs",
    "test:test-workflow": "node --test scripts/test-workflow.test.mjs",
    "test:results": "node --test scripts/results-workflow.test.mjs",
    "test:preferences": "node --test scripts/preferences.test.mts",
    "test:review-ui": "node --test scripts/review-list.test.mts scripts/review-detail.test.mts",
    "browser:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/browser-check.ps1",
    "browser:review": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/review-browser-check.ps1",
    "check": "npm run test:time && npm run test:review-archive && npm run test:copy && npm run test:api && npm run test:test-workflow && npm run test:results && npm run test:preferences && npm run test:review-ui && npm run typecheck && npm run build && npm run copy:check && npm run built:check",
    "test": "bash scripts/integrate.sh test",
    "start": "bash scripts/run.sh",
    "deploy:check": "bash scripts/integrate.sh deploy:check",
    "verify": "bash scripts/integrate.sh verify"
  }
}
